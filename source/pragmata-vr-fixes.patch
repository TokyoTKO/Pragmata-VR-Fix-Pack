+                if (b.Transition.pResource != active->output[i]) continue;
+                if (b.Flags != D3D12_RESOURCE_BARRIER_FLAG_NONE ||
+                    (b.Transition.Subresource != D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES && b.Transition.Subresource != 0)) {
