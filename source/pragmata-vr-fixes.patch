+static bool list_menu_active(uint64_t frame) {
+    const auto last_draw = list_menu_draw_frame.load(std::memory_order_relaxed);
+    const bool recent_draw = last_draw != std::numeric_limits<uint64_t>::max() &&
+        frame >= last_draw && frame - last_draw <= 1;
+    int priority = -1;
+    if (recent_draw && g_framework->is_ready()) {
+        static sdk::REMethodDefinition* getter = nullptr;
+        if (!getter) {
+            auto* type = sdk::find_type_definition("app.GuiManager");
+            if (type) getter = type->get_method("get_CurrentInputLevel");
