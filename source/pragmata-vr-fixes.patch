+    auto desc = found->desc.pTexture->GetDesc();
+    if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || desc.MipLevels != 1 ||
+        desc.DepthOrArraySize != 1 || desc.SampleDesc.Count != 1) return false;
