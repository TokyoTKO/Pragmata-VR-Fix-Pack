+        if (getter && getter->get_num_params() == 0) {
+            auto* manager = sdk::get_managed_singleton<::REManagedObject>("app.GuiManager");
+            if (manager) priority = getter->call<int>(sdk::get_thread_context(), manager);
+        }
+    }
+    const bool active = recent_draw && priority >= 300;
+    static int last_active = -1;
+    if (last_active != static_cast<int>(active)) {
+        spdlog::info("[PragmataMenuV18] structuralMenu={} inputPriority={} recentListDraw={} frame={}",
